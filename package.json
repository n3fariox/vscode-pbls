{
  "name": "vscode-pbls",
  "displayName": "vscode-pbls",
  "description": "Protobuf support for Visual Studio Code powered by pbls",
  "version": "0.6.1",
  "publisher": "n3fariox",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "images/proto_pbls.png",
  "homepage": "https://github.com/n3fariox/vscode-pbls/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/n3fariox/vscode-pbls"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "extensionDependencies": [
    "mindaro-dev.file-downloader"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:proto3"
  ],
  "main": "./out/main.js",
  "contributes": {
    "languages": [
      {
        "id": "proto3",
        "extensions": [
          ".proto"
        ],
        "aliases": [
          "Protocol Buffers"
        ]
      }
    ],
    "grammars": [
      {
        "language": "proto3",
        "scopeName": "source.proto",
        "path": "./syntaxes/proto3.tmLanguage.json"
      },
      {
        "scopeName": "markdown.codeblock.proto",
        "path": "./syntaxes/proto3.codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "snippets": [
      {
        "language": "proto3",
        "path": "./snippets/proto3.json"
      },
      {
        "language": "proto3",
        "path": "./snippets/google-api.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Pbls Settings",
      "properties": {
        "pbls.path": {
          "type": "string",
          "default": "pbls",
          "description": "Path to pbls executable"
        },
        "pbls.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "description": "Log level for pbls output channel and server process"
        },
        "clang-format.style": {
          "type": "string",
          "default": "file",
          "description": "Clang-format style for formatting proto files. Can be 'file' to use .clang-format, or a style name like 'Google', 'LLVM', 'Chromium', 'Mozilla', 'WebKit', or an inline style configuration."
        },
        "clang-format.executable": {
          "type": "string",
          "default": "clang-format",
          "description": "Path to the clang-format executable"
        }
      }
    },
    "commands": [
      {
        "command": "proto3.reloadLanguageServer",
        "title": "Reload Protobuf Language Server",
        "category": "Protobuf"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -watch -p ./",
    "build": "tsc -p ./",
    "bundle": "esbuild src/proto3Main.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node --minify",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:md": "markdownlint **/*.md --ignore node_modules",
    "lint:md:fix": "markdownlint **/*.md --ignore node_modules --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "verify": "npm run lint && npm run lint:md && npm run format:check",
    "package:vsix": "vsce package --out vscode-pbls-${npm_package_version}.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.12",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.17.0",
    "lint-staged": "^16.2.7",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.49.0"
  },
  "dependencies": {
    "@microsoft/vscode-file-downloader-api": "^1.0.1",
    "vscode-languageclient": "^9.0.0"
  },
  "lint-staged": {
    "*.{ts,js,json}": "prettier --write",
    "*.md": [
      "markdownlint --fix",
      "prettier --write"
    ]
  }
}
